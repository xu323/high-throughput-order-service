# =============================================================
# .env.example
# 複製為 .env 後再修改值；.env 已被 .gitignore 排除。
# 在本機開發直接 docker compose up 即可，使用以下預設值。
# =============================================================

# ---- App ----
APP_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ---- MySQL ----
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=orderdb
MYSQL_USER=orderuser
MYSQL_PASSWORD=orderpass
MYSQL_ROOT_PASSWORD=rootpass

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- RabbitMQ ----
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ---- ThreadPool ----
ASYNC_CORE_POOL_SIZE=8
ASYNC_MAX_POOL_SIZE=32
ASYNC_QUEUE_CAPACITY=500

# ---- Order ----
ORDER_TIMEOUT_MINUTES=15
